<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>MessageTransit</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>MessageTransit.DapperIntegration</PackageId>
    <Title>MessageTransit.DapperIntegration</Title>
    <PackageTags>MessageTransit;Dapper</PackageTags>
    <Description>MessageTransit Dapper persistence support; $(Description)</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MessageTransit\MessageTransit.csproj" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="dapper.contrib" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- Microsoft.Data.SqlClient accepts System.Security.Cryptography.Pkcs 9.0.11, which has a high severity advisory -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

</Project>
