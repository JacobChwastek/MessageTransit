<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MessageTransit</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>MessageTransit.SqlTransport.SqlServer</PackageId>
    <Title>MessageTransit.SqlTransport.SQL Server</Title>
    <PackageTags>MessageTransit;Database;Transport;SQL Server;Microsoft;Azure;SQL</PackageTags>
    <Description>MessageTransit SQL Server Transport; $(Description)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- Microsoft.Data.SqlClient accepts System.Security.Cryptography.Pkcs 9.0.11, which has a high severity advisory -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MessageTransit\MessageTransit.csproj" />
  </ItemGroup>
</Project>
